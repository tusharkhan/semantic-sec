{
    "name": "tusharkhan/semantic-sec",
    "description": "LLM-assisted authorization and IDOR scanner for Laravel applications.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "security", "idor", "authorization", "scanner"],
    "authors": [
        {
            "name": "Tushar Khan",
            "email": "tushar.khan0122@gmail.com"
        }
    ],
    "bin": ["bin/semantic-sec"],
    "require": {
        "php": "^8.2",
        "doctrine/inflector": "^2.0",
        "nikic/php-parser": "^5.0",
        "phpstan/phpdoc-parser": "^2.0",
        "symfony/console": "^6.4 || ^7.0",
        "symfony/yaml": "^6.4 || ^7.0"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.4"
    },
    "autoload": {
        "psr-4": {
            "TusharKhan\\SemanticSec\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TusharKhan\\SemanticSec\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=512M",
        "lint": "pint --test",
        "format": "pint"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
