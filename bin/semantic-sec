#!/usr/bin/env php
<?php

declare(strict_types=1);

use TusharKhan\SemanticSec\Console\Application;

$autoloaders = [__DIR__ . '/../vendor/autoload.php', __DIR__ . '/../../../autoload.php'];

foreach ($autoloaders as $autoloader) {
    if (is_file($autoloader)) {
        require $autoloader;

        exit((new Application())->run());
    }
}

fwrite(STDERR, "Composer autoloader not found. Run 'composer install'.\n");
exit(2);
